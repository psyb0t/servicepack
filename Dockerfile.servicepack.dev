# Development Dockerfile
# Pinned by digest, not by tag — a tag is mutable and lets an upstream
# republish different bytes under the same name. Bump deliberately.
FROM golang:1.26.9-alpine@sha256:cdfd4fe2da6b225d8b40c6b7a105736e548e83ff56d5d8f9394446eeb5eb84e0

# Install build dependencies
RUN apk add --no-cache \
    make \
    gcc \
    musl-dev \
    bash \
    curl \
    git \
    jq \
    shellcheck \
    shfmt \
    python3 \
    py3-pip

# semgrep for the security scan (make sec). Modern semgrep works on alpine musl.
RUN pip install --break-system-packages --no-cache-dir semgrep==1.173.0

# Set working directory
WORKDIR /app

# Copy source code
COPY . .

# Set env vars
ENV ENV=dev
ENV LOG_LEVEL=debug
ENV LOG_FORMAT=text
ENV LOG_ADD_SOURCE=true
ENV SERVICES_ENABLED=
ENV GOPROXY=https://proxy.golang.org,direct
ENV GOSUMDB=sum.golang.org

# Default command - shows available make targets
CMD ["make", "help"]
